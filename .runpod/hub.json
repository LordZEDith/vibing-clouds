{
  "title": "Vibing Clouds",
  "description": "VibeVoice-ASR speech-to-text (vLLM, OpenAI-compatible) for the Vibing dictation app. Uses RunPod cached models for lower scale-to-zero cold-start cost. Sends base64 audio, returns a transcript. Gemma polish is available but off by default in this spike.",
  "type": "serverless",
  "category": "audio",
  "iconUrl": "https://avatars.githubusercontent.com/u/11708006?v=4",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 30,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80",
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4"
    ],
    "presets": [
      {
        "name": "ASR only (cold-start spike)",
        "defaults": {
          "VIBING_GEMMA_ENABLED": "0",
          "VIBING_ASR_MODEL": "microsoft/VibeVoice-ASR",
          "VIBING_ASR_TOKENIZER_PATH": "/app/vibevoice-tokenizer",
          "VIBING_ASR_GPU_MEM_UTIL": "0.88",
          "VIBING_ASR_MAX_MODEL_LEN": "2048",
          "VIBING_ASR_MAX_NUM_SEQS": "1",
          "VIBING_ASR_MAX_NUM_BATCHED_TOKENS": "2048",
          "VIBING_ASR_MAX_OUTPUT_TOKENS": "1024",
          "VIBING_ASR_ENFORCE_EAGER": "1",
          "VIBING_ASR_LOCAL_FILES_ONLY": "1",
          "VIBING_ASR_ALLOW_RUNTIME_DOWNLOAD": "0",
          "VIBING_HF_CACHE_ROOT": "/runpod-volume/huggingface-cache/hub",
          "MODEL_NAME": "microsoft/VibeVoice-ASR",
          "RUNPOD_INIT_TIMEOUT": "800",
          "PYTORCH_ALLOC_CONF": "expandable_segments:True",
          "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
        }
      }
    ],
    "env": [
      {
        "key": "VIBING_ASR_MODEL",
        "input": {
          "name": "ASR cached model",
          "type": "huggingface",
          "description": "Hugging Face model id. Also set the endpoint Model field to this value so RunPod pre-caches it.",
          "default": "microsoft/VibeVoice-ASR",
          "required": true
        }
      },
      {
        "key": "MODEL_NAME",
        "value": "microsoft/VibeVoice-ASR"
      },
      {
        "key": "VIBING_ASR_TOKENIZER_PATH",
        "value": "/app/vibevoice-tokenizer"
      },
      {
        "key": "VIBING_HF_CACHE_ROOT",
        "value": "/runpod-volume/huggingface-cache/hub"
      },
      {
        "key": "RUNPOD_INIT_TIMEOUT",
        "value": "800"
      },
      {
        "key": "VIBING_ASR_ALLOW_RUNTIME_DOWNLOAD",
        "input": {
          "name": "Allow runtime model download",
          "type": "string",
          "description": "Keep off. Only turn on for debugging if the endpoint Model field was not set and you accept a slow billed startup.",
          "options": [
            {
              "label": "Off",
              "value": "0"
            },
            {
              "label": "On",
              "value": "1"
            }
          ],
          "default": "0",
          "advanced": true
        }
      },
      {
        "key": "VIBING_GEMMA_ENABLED",
        "input": {
          "name": "Enable Gemma polish",
          "type": "string",
          "description": "Load Gemma-4 for transcript polish. Off for the ASR-only spike; needs a 24GB+ card and an HF token for the gated model when on.",
          "options": [
            {
              "label": "Off (ASR only)",
              "value": "0"
            },
            {
              "label": "On",
              "value": "1"
            }
          ],
          "default": "0"
        }
      },
      {
        "key": "VIBING_ASR_GPU_MEM_UTIL",
        "input": {
          "name": "ASR GPU memory fraction",
          "type": "string",
          "description": "vLLM --gpu-memory-utilization for VibeVoice-ASR. Default targets one A100 80GB worker.",
          "default": "0.88"
        }
      },
      {
        "key": "VIBING_ASR_MAX_MODEL_LEN",
        "input": {
          "name": "ASR max model length",
          "type": "string",
          "description": "vLLM --max-model-len. 2048 gives real dictation room for the structured ASR response on A100 80GB.",
          "default": "2048"
        }
      },
      {
        "key": "VIBING_ASR_MAX_NUM_SEQS",
        "input": {
          "name": "ASR max sequences",
          "type": "string",
          "description": "vLLM --max-num-seqs. Vibing sends one dictation request at a time, so 1 minimizes startup memory.",
          "default": "1"
        }
      },
      {
        "key": "VIBING_ASR_MAX_NUM_BATCHED_TOKENS",
        "input": {
          "name": "ASR batch token cap",
          "type": "string",
          "description": "vLLM --max-num-batched-tokens. Keep equal to max model length for one short dictation request.",
          "default": "2048"
        }
      },
      {
        "key": "VIBING_ASR_MAX_OUTPUT_TOKENS",
        "input": {
          "name": "ASR output token cap",
          "type": "string",
          "description": "OpenAI max_tokens for the ASR response. 1024 avoids truncating normal dictation transcripts.",
          "default": "1024"
        }
      },
      {
        "key": "VIBING_ASR_ENFORCE_EAGER",
        "input": {
          "name": "ASR eager mode",
          "type": "string",
          "description": "Set to 1 to disable CUDA graph capture and reduce vLLM startup memory.",
          "options": [
            {
              "label": "On",
              "value": "1"
            },
            {
              "label": "Off",
              "value": "0"
            }
          ],
          "default": "1"
        }
      }
    ]
  }
}
