{
  "tests": [
    {
      "name": "asr_smoke",
      "input": {
        "audio_b64": "",
        "audio_mime": "audio/wav",
        "hotwords": [
          "Vibing"
        ]
      },
      "timeout": 900000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA L4",
    "gpuCount": 1,
    "env": [
      {
        "key": "VIBING_GEMMA_ENABLED",
        "value": "0"
      },
      {
        "key": "VIBING_ASR_GPU_MEM_UTIL",
        "value": "0.90"
      },
      {
        "key": "VIBING_ASR_MAX_MODEL_LEN",
        "value": "1024"
      },
      {
        "key": "VIBING_ASR_MAX_NUM_SEQS",
        "value": "1"
      },
      {
        "key": "VIBING_ASR_MAX_NUM_BATCHED_TOKENS",
        "value": "1024"
      },
      {
        "key": "VIBING_ASR_ENFORCE_EAGER",
        "value": "1"
      },
      {
        "key": "VIBING_ASR_LOCAL_FILES_ONLY",
        "value": "1"
      },
      {
        "key": "PYTORCH_CUDA_ALLOC_CONF",
        "value": "expandable_segments:True"
      }
    ],
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4"
    ]
  }
}
